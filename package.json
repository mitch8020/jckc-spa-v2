{
  "name": "jckc-spa-v2-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install": "node scripts/install-workspace.mjs",
    "i": "npm run install --",
    "deploy": "npm run deploy:dev --",
    "deploy:dev": "node scripts/run-local.mjs --env dev --target both",
    "deploy:prod": "node scripts/run-local.mjs --env prod --target both",
    "dev": "npm run start:dev --",
    "prod": "npm run start:prod --",
    "dev:all": "npm run deploy:dev --",
    "prod:all": "npm run deploy:prod --",
    "start:dev": "node scripts/run-local.mjs --env dev --target both",
    "start:prod": "node scripts/run-local.mjs --env prod --target both",
    "dev:backend": "node scripts/run-local.mjs --env dev --target backend",
    "dev:frontend": "node scripts/run-local.mjs --env dev --target frontend",
    "prod:backend": "node scripts/run-local.mjs --env prod --target backend",
    "prod:frontend": "node scripts/run-local.mjs --env prod --target frontend",
    "build": "node scripts/run-command.mjs --phase build --target both",
    "build:all": "npm run build --",
    "build:backend": "node scripts/run-command.mjs --phase build --target backend",
    "build:frontend": "node scripts/run-command.mjs --phase build --target frontend",
    "lint": "node scripts/run-command.mjs --phase lint --target both",
    "lint:all": "npm run lint --",
    "lint:backend": "node scripts/run-command.mjs --phase lint --target backend",
    "lint:frontend": "node scripts/run-command.mjs --phase lint --target frontend",
    "test": "node scripts/run-command.mjs --phase test --target both",
    "test:all": "npm run test --",
    "test:backend": "node scripts/run-command.mjs --phase test --target backend",
    "test:frontend": "node scripts/run-command.mjs --phase test --target frontend",
    "test:e2e": "npm run test:e2e:backend && npm run test:e2e:frontend",
    "test:e2e:backend": "npm --prefix jckc-spa-backend run test:e2e",
    "test:e2e:frontend": "npm --prefix jckc-spa-frontend run test:e2e",
    "blt": "node scripts/run-blt.mjs --target both",
    "blt:backend": "node scripts/run-blt.mjs --target backend --label jckc-spa-backend",
    "blt:frontend": "node scripts/run-blt.mjs --target frontend --label jckc-spa-frontend"
  }
}
