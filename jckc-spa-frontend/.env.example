# Base URL of the JCKC NestJS backend. All REST calls (/api/*) and better-auth
# endpoints (/api/auth/*) are served from this origin. The frontend dev server
# may be opened on localhost or 127.0.0.1; the app keeps loopback API calls on
# the same hostname in the browser so OAuth cookies survive the Google redirect.
VITE_API_URL=http://127.0.0.1:3001
