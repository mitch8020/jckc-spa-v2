# Base URL of the JCKC NestJS backend. Leave unset in a single-origin Heroku
# deployment where the Nest backend serves this frontend and /api/*.
#
# For local split-server development, set this to the backend origin. The
# frontend dev server may be opened on localhost or 127.0.0.1; the app keeps
# loopback API calls on the same hostname in the browser so OAuth cookies
# survive the Google redirect.
VITE_API_URL=http://127.0.0.1:3001
