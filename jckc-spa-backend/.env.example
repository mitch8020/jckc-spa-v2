# MongoDB connection string. Domain collections (students/classrooms/
# guardians) AND better-auth collections (users/account/session) live in
# this database.
MONGO_URI=mongodb://localhost:27017/jckc-v2

# Optional comma-separated DNS servers used for mongodb+srv:// SRV lookups.
# Leave blank unless your local DNS resolver refuses Atlas SRV queries.
MONGO_DNS_SERVERS=

# Port the NestJS API listens on (frontend dev server uses 3000).
PORT=3001

# Absolute URL of this backend — better-auth endpoints are served at
# <BETTER_AUTH_URL>/api/auth/*.
BETTER_AUTH_URL=http://127.0.0.1:3001

# Secret used by better-auth for session/cookie signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Frontend origin allowed for CORS (credentials) and trusted by better-auth.
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Google OAuth credentials (optional — Google sign-in is disabled when
# either is unset; email/password auth still works).
# Local Google redirect URIs:
#   http://localhost:3001/api/auth/callback/google
#   http://127.0.0.1:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to authenticate. Defaults in code:
# jpmitra.swe@gmail.com, mitrajs@yahoo.com, khinson60@yahoo.com.
AUTH_ALLOWED_EMAILS=jpmitra.swe@gmail.com,mitrajs@yahoo.com,khinson60@yahoo.com

# Comma-separated list of emails that become 'admin' when they complete
# registration (bootstrap mechanism; optional).
ADMIN_EMAILS=
