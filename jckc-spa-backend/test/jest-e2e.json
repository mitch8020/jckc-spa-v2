{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node10",
          "esModuleInterop": true
        }
      }
    ],
    "^.+\\.mjs$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node10",
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules[\\\\/](?!(better-auth|@better-auth|better-call|nanostores|kysely|jose|@noble|rou3|uncrypto)[\\\\/])"
  ]
}
